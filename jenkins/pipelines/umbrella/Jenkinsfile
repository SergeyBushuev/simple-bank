pipeline {
    agent any

    environment {
        K8S_NAMESPACE_DEV = 'bankapp-dev'
        K8S_NAMESPACE_TEST = 'bankapp-test'
        K8S_NAMESPACE_PROD = 'bankapp-prod'

        DOCKER_REGISTRY = credentials('DOCKER_REGISTRY')
        GITHUB_USERNAME = credentials('GITHUB_USERNAME')
        IMAGE_TAG = "${env.BUILD_NUMBER}"
    }

    parameters {
        choice(name: 'DEPLOY_ENV', choices: ['dev', 'test', 'prod'], description: 'Environment to deploy to')
        booleanParam(name: 'SKIP_TESTS', defaultValue: false, description: 'Skip Helm tests')
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    stages {
        stage('Инициализация') {
            steps {
                echo "Запуск полного цикла сборки и деплоя bankapp"
                echo "Окружение: ${params.DEPLOY_ENV}"
            }
        }

        stage('Получение исходников') {
            steps {
                checkout scm
            }
        }

        stage('Сборка всех проектов') {
            steps {
                sh "./gradlew clean build -x test"
                archiveArtifacts artifacts: "**/build/libs/*.jar", fingerprint: true
            }
        }

        stage('Запуск тестов') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    sh "./gradlew test"
                }
            }
            post {
                always {
                    junit "**/build/test-results/test/*.xml"
                }
            }
        }

        stage('Сборка Docker образов') {
            parallel {
                stage('bank-accounts образ') {
                    steps {
                        sh """
                            docker build -f bank-accounts/Dockerfile \\
                            --build-arg JAR_FILE=build/libs/*.jar \\
                            -t ${DOCKER_REGISTRY}/bank-accounts:${IMAGE_TAG} .
                        """
                    }
                }
                stage('service-apigw образ') {
                    steps {
                        sh """
                            docker build -f bank-gateway/Dockerfile \\
                            --build-arg JAR_FILE=build/libs/*.jar \\
                            -t ${DOCKER_REGISTRY}/service-apigw:${IMAGE_TAG} .
                        """
                    }
                }
                stage('bank-cash образ') {
                    steps {
                        sh """
                            docker build -f bank-cash/Dockerfile \\
                            --build-arg JAR_FILE=build/libs/*.jar \\
                            -t ${DOCKER_REGISTRY}/bank-cash:${IMAGE_TAG} .
                        """
                    }
                }
                stage('bank-transfer образ') {
                    steps {
                        sh """
                            docker build -f bank-transfer/Dockerfile \\
                            --build-arg JAR_FILE=build/libs/*.jar \\
                            -t ${DOCKER_REGISTRY}/bank-transfer:${IMAGE_TAG} \\
                            .
                        """
                    }
                }
                stage('service-convert образ') {
                    steps {
                        sh """
                            docker build -f service-convert/Dockerfile \\
                            --build-arg JAR_FILE=build/libs/*.jar \\
                            -t ${DOCKER_REGISTRY}/service-convert:${IMAGE_TAG} .
                        """
                    }
                }
                stage('bank-exchange-generator образ') {
                    steps {
                        sh """
                            docker build -f bank-exchange-generator/Dockerfile \\
                            --build-arg JAR_FILE=build/libs/*.jar \\
                            -t ${DOCKER_REGISTRY}/bank-exchange-generator:${IMAGE_TAG} .
                        """
                    }
                }
                stage('bank-blocker образ') {
                    steps {
                        sh """
                            docker build -f bank-blocker/Dockerfile \\
                            --build-arg JAR_FILE=build/libs/*.jar \\
                            -t ${DOCKER_REGISTRY}/bank-blocker:${IMAGE_TAG} .
                        """
                    }
                }
                stage('bank-notifications образ') {
                    steps {
                        sh """
                            docker build -f bank-notifications/Dockerfile \\
                            --build-arg JAR_FILE=build/libs/*.jar \\
                            -t ${DOCKER_REGISTRY}/bank-notifications:${IMAGE_TAG} .
                        """
                    }
                }
                stage('bank-front образ') {
                    steps {
                        sh """
                            docker build -f bank-front/Dockerfile \\
                            --build-arg JAR_FILE=build/libs/*.jar \\
                            -t ${DOCKER_REGISTRY}/bank-front:${IMAGE_TAG} .
                        """
                    }
                }
            }
        }

        stage('Публикация Docker образов') {
            steps {
                withCredentials([string(credentialsId: 'GHCR_TOKEN', variable: 'GHCR_TOKEN')]) {
                    sh """
                        echo \$GHCR_TOKEN | docker login ghcr.io -u ${GITHUB_USERNAME} --password-stdin

                        docker push ${DOCKER_REGISTRY}/bank-accounts:${IMAGE_TAG}
                        docker push ${DOCKER_REGISTRY}/service-apigw:${IMAGE_TAG}
                        docker push ${DOCKER_REGISTRY}/bank-cash:${IMAGE_TAG}
                        docker push ${DOCKER_REGISTRY}/bank-transfer:${IMAGE_TAG}
                        docker push ${DOCKER_REGISTRY}/service-convert:${IMAGE_TAG}
                        docker push ${DOCKER_REGISTRY}/bank-exchange-generator:${IMAGE_TAG}
                        docker push ${DOCKER_REGISTRY}/bank-blocker:${IMAGE_TAG}
                        docker push ${DOCKER_REGISTRY}/bank-notifications:${IMAGE_TAG}
                        docker push ${DOCKER_REGISTRY}/bank-front:${IMAGE_TAG}
                    """
                }
            }
        }


        stage('Подготовка Helm зависимостей') {
            steps {
                sh """
                    helm repo add bitnami https://charts.bitnami.com/bitnami || true
                    helm repo update
                    helm dependency build ./helm/bankapp
                """
            }
        }

        stage('Очистка конфликтующих ресурсов') {
            steps {
                script {
                    def namespace = ""
                    if (params.DEPLOY_ENV == 'dev') {
                        namespace = K8S_NAMESPACE_DEV
                    } else if (params.DEPLOY_ENV == 'test') {
                        namespace = K8S_NAMESPACE_TEST
                    } else if (params.DEPLOY_ENV == 'prod') {
                        namespace = K8S_NAMESPACE_PROD
                    }

                    sh """
                        # Удаляем конфликтующие Ingress ресурсы
                        kubectl delete ingress --all -n ${namespace} --ignore-not-found=true || true
                        kubectl delete ingress --all -n bankapp --ignore-not-found=true || true
                    """
                }
            }
        }

        stage('monitoring deploy') {
            when {
                anyOf {
                    expression { params.DEPLOY_ENV == 'dev' }
                    expression { params.DEPLOY_ENV == 'test' }
                    expression { params.DEPLOY_ENV == 'prod' }
                }
            }
            steps {
                script {
                    echo "monitoring deploy ${params.DEPLOY_ENV} (namespace: monitoring)"

                    sh """
                        helm install zipkin bitnami/zipkin -n monitoring --create-namespace -f helm/zipkin/values-zipkin.yaml
                    """
                }
            }
        }

        stage('Деплой') {
            when {
                anyOf {
                    expression { params.DEPLOY_ENV == 'dev' }
                    expression { params.DEPLOY_ENV == 'test' }
                    expression { params.DEPLOY_ENV == 'prod' }
                }
            }
            steps {
                script {
                    def namespace = ""
                    if (params.DEPLOY_ENV == 'dev') {
                        namespace = K8S_NAMESPACE_DEV
                    } else if (params.DEPLOY_ENV == 'test') {
                        namespace = K8S_NAMESPACE_TEST
                    } else if (params.DEPLOY_ENV == 'prod') {
                        namespace = K8S_NAMESPACE_PROD
                    }

                    echo "Деплой в окружение ${params.DEPLOY_ENV} (namespace: ${namespace})"

                    sh """
                        helm upgrade --install bankapp ./helm/bankapp \\
                        --namespace ${namespace} \\
                        --create-namespace \\
                        --timeout=600s \\
                        --wait \\
                        --set bank-accounts.image.repository=${DOCKER_REGISTRY}/bank-accounts \\
                        --set bank-accounts.image.tag=${IMAGE_TAG} \\
                        --set bank-gateway.image.repository=${DOCKER_REGISTRY}/service-apigw \\
                        --set bank-gateway.image.tag=${IMAGE_TAG} \\
                        --set bank-cash.image.repository=${DOCKER_REGISTRY}/bank-cash \\
                        --set bank-cash.image.tag=${IMAGE_TAG} \\
                        --set bank-transfer.image.repository=${DOCKER_REGISTRY}/bank-transfer \\
                        --set bank-transfer.image.tag=${IMAGE_TAG} \\
                        --set service-convert.image.repository=${DOCKER_REGISTRY}/service-convert \\
                        --set service-convert.image.tag=${IMAGE_TAG} \\
                        --set bank-exchange-generator.image.repository=${DOCKER_REGISTRY}/bank-exchange-generator \\
                        --set bank-exchange-generator.image.tag=${IMAGE_TAG} \\
                        --set bank-blocker.image.repository=${DOCKER_REGISTRY}/bank-blocker \\
                        --set bank-blocker.image.tag=${IMAGE_TAG} \\
                        --set bank-notifications.image.repository=${DOCKER_REGISTRY}/bank-notifications \\
                        --set bank-notifications.image.tag=${IMAGE_TAG} \\
                        --set bank-front.image.repository=${DOCKER_REGISTRY}/bank-front \\
                        --set bank-front.image.tag=${IMAGE_TAG}
                    """
                }
            }
        }

        stage('Проверка готовности Kafka') {
            when {
                anyOf {
                    expression { params.DEPLOY_ENV == 'dev' }
                    expression { params.DEPLOY_ENV == 'test' }
                    expression { params.DEPLOY_ENV == 'prod' }
                }
            }
            steps {
                script {
                    def namespace = ""
                    if (params.DEPLOY_ENV == 'dev') {
                        namespace = K8S_NAMESPACE_DEV
                    } else if (params.DEPLOY_ENV == 'test') {
                        namespace = K8S_NAMESPACE_TEST
                    } else if (params.DEPLOY_ENV == 'prod') {
                        namespace = K8S_NAMESPACE_PROD
                    }

                    echo "Ожидание готовности Kafka в ${namespace}..."

                    sh """
                        # Ожидаем готовности Kafka pod
                        kubectl wait --for=condition=Ready pod -l app.kubernetes.io/name=kafka \\
                            -n ${namespace} --timeout=300s || true

                        # Проверяем статус Kafka
                        echo "Статус Kafka pods:"
                        kubectl get pods -l app.kubernetes.io/name=kafka -n ${namespace} || true

                        # Проверяем Kafka service
                        echo "Kafka services:"
                        kubectl get svc -l app.kubernetes.io/name=kafka -n ${namespace} || true
                    """
                }
            }
        }


        stage('Подтверждение для Production') {
            when {
                expression { params.DEPLOY_ENV == 'prod' }
            }
            input {
                message "Подтвердите деплой в Production"
                ok "Deploy to Production"
                parameters {
                    choice(name: 'CONFIRM_PROD', choices: ['no', 'yes'], description: 'Подтвердить деплой в production')
                }
            }
            steps {
                script {
                    if (params.CONFIRM_PROD != 'yes') {
                        error("Деплой в production отменен пользователем")
                    }
                    echo "Деплой в production подтвержден"
                }
            }
        }
    }

    post {
        always {
            script {
                def namespace = ""
                if (params.DEPLOY_ENV == 'dev') {
                    namespace = K8S_NAMESPACE_DEV
                } else if (params.DEPLOY_ENV == 'test') {
                    namespace = K8S_NAMESPACE_TEST
                } else if (params.DEPLOY_ENV == 'prod') {
                    namespace = K8S_NAMESPACE_PROD
                }

                echo "Итоговый статус деплоя в ${params.DEPLOY_ENV}:"
                sh """
                    echo "=== ВСЕ PODS ==="
                    kubectl get pods -n ${namespace} || true

                    echo "=== KAFKA PODS ==="
                    kubectl get pods -l app.kubernetes.io/name=kafka -n ${namespace} || true

                    echo "=== SERVICES ==="
                    kubectl get svc -n ${namespace} || true
                """
            }
        }
        success {
            echo "Umbrella деплой bankapp в ${params.DEPLOY_ENV} завершен успешно"
        }
        failure {
            echo "Umbrella деплой bankapp в ${params.DEPLOY_ENV} завершился с ошибкой"
        }
    }
}